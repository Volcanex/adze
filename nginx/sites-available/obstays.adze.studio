# OB Stays (slug `tom`) — review domain.
#
# Temporary home while obstays.net is unregistered. When the real domain
# lands, give it its own vhost and keep or drop this one; artists/tom/
# config.json already declares `domain: obstays.net`, so canonical and
# sitemap URLs already point there, NOT here.
server {
    server_name obstays.adze.studio;

    root /home/gabriel/adze/output/artists/tom;

    # Single-page site: / must land on the compiled home page, not the
    # bare redirect stub that compile.py writes at the artist root.
    location = / {
        return 302 /home/;
    }

    location /assets/ {
        alias /home/gabriel/adze/output/artists/tom/assets/;
        expires 24h;
        add_header Cache-Control "public, max-age=86400";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 220M;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ @api;
    }

    location @api {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # http->https and ACME renewal are handled by the shared *.adze.studio
    # block (workspace.adze.studio), so no :80 listener here.
    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/obstays.adze.studio/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/obstays.adze.studio/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
