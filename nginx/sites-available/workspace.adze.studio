# Workspace admin hub — {workspace}.adze.studio
# Each subdomain of adze.studio (other than adze.studio itself, which has its
# own vhost) routes here. The SPA reads the subdomain from window.location
# and scopes the view to that workspace.
server {
    server_name *.adze.studio;

    listen 80;
    listen [::]:80;

    # Full Adze admin, served on the workspace subdomain. Same SPA shell as
    # adze.studio/admin — the dashboard scopes itself to the logged-in
    # identity's workspace. Root IS the admin here (unlike adze.studio root,
    # which is the marketing home).
    location = / {
        proxy_pass http://127.0.0.1:5001/api/adze/admin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /admin and /admin/artist/<slug> — prefix proxy_pass maps the path 1:1
    # onto /api/adze/admin/... so SPA deep links survive a refresh.
    location /admin {
        proxy_pass http://127.0.0.1:5001/api/adze/admin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Per-artist editor opened from the admin "Dashboard" button.
    location = /dashboard {
        proxy_pass http://127.0.0.1:5001/api/adze/dashboard;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Compiled artist output + same-origin preview iframe (used by the editor).
    location /static/ {
        alias /home/gabriel/adze/static/;
        expires 24h;
    }
    location /preview/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Terminal Access / live widgets.
    location /socket.io/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /favicon.ico {
        proxy_pass http://127.0.0.1:5001/api/adze/favicon.ico;
        proxy_set_header Host $host;
        expires 24h;
    }

    # Intake portal — client upload pages (linked from this workspace's domain)
    location /intake/ {
        proxy_pass http://127.0.0.1:5001/api/adze/intake/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 2G;
    }

    # Handover portal — client credential handover
    location /handover/ {
        proxy_pass http://127.0.0.1:5001/api/adze/handover/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API passthrough (WebSocket + SSE support)
    location /api/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        client_max_body_size 2G;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
    }
}
