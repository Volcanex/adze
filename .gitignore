# Python
__pycache__/
*.pyc
venv/

# Artist assets (backed up separately)
artists/*/assets/

# Artist snapshots
artists/*/.snapshots/

# Per-artist git repo used by Auto-Coder tabs/worktrees. Files in
# artists/<slug>/ are still tracked by the outer adze repo; the nested
# .git only carries the inner history opencode uses for tab isolation.
artists/*/.git/

# Runtime data
data/
uploads/
logs/
artists/*/analytics.json
# when a site started counting (written by compile.py; runtime state,
# deliberately NOT in the hand-authored config.json)
artists/*/.analytics.json
artists/*/analytics.json.bak
artists/*/data.db
artists/*/data.db-shm
artists/*/data.db-wal
_claude_sessions.json
_vibe_sessions/
# aider session files (per-artist, regenerated on each session)
artists/*/.aider.chat.history.md
artists/*/.aider.input.history
artists/*/.adze-context.md
*.pid

# Secrets
artists/*/.env
.env

# External (remote Seed) artists — per-deployment SSH key + manifest cache
artists/*/ssh_key
artists/*/ssh_key.pub
artists/*/.adze-remote.cache.json

# Compiled output
output/

# Temp files
*.tmp
.DS_Store

# Agent worktrees — full repo copies, never committed
.claude/worktrees/
